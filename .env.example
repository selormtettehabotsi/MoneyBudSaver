# Root .env.example (Copy to backend/.env and .env)
# Generate a cryptographically secure 64-hex-char SECRET_KEY:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
INVITE_CODE=
ENVIRONMENT=development
DEPLOYMENT_MODE=local
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=sqlite:///./moneycouncil.db

# Scheduled Weekly Review Webhook Secret (X-Cron-Secret header)
# python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=replace_with_a_secure_cron_secret_64_hex_chars
AI_PROVIDER_TIMEOUT_SECONDS=25

# Hard Financial Guardrail Defaults (Single Source of Truth)
DEFAULT_MAX_DTI_RATIO=40.0
DEFAULT_MIN_RUNWAY_MONTHS=3.0
DEFAULT_CURRENCY=GHS

# Core Free AI Providers (4 Distinct Model Families)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL_ID=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=qwen/qwen-2.5-72b-instruct:free

# Optional Paid / Trial Providers (Off by default, requires payment method or trial credit)
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL_ID=llama3.3-70b

# Local Offline Provider (Disabled in hosted mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=llama3.2
