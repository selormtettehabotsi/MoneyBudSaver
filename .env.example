# Root .env.example (Copy to backend/.env and .env)
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
INVITE_CODE=
ENVIRONMENT=development
DEPLOYMENT_MODE=local
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=sqlite:///./moneycouncil.db
INTERNAL_CRON_SECRET=replace_with_a_secure_cron_secret_for_uptimerobot
AI_PROVIDER_TIMEOUT_SECONDS=25

# Hard Financial Guardrail Defaults
DEFAULT_MAX_DTI_RATIO=40.0
DEFAULT_MIN_RUNWAY_MONTHS=3.0
DEFAULT_CURRENCY=GHS

# AI Providers & Model Families
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL_ID=llama3.3-70b

MISTRAL_API_KEY=
MISTRAL_MODEL_ID=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=deepseek/deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=llama3.2
