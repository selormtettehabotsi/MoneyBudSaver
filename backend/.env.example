# -------------------------------------------------------------
# MoneyCouncil Environment Configuration
# -------------------------------------------------------------

# Application Security
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
INVITE_CODE=
ENVIRONMENT=development
DEPLOYMENT_MODE=local   # "local" allows Ollama; "hosted" disables local-only Ollama mode
COOKIE_SECURE=false     # Set to true when running under HTTPS in production
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Database (Leave as SQLite for zero-config local, or use Postgres Neon / Supabase URL)
DATABASE_URL=sqlite:///./moneycouncil.db

# Internal Cron Keep-Alive / Review Secret
INTERNAL_CRON_SECRET=replace_with_a_secure_cron_secret_for_uptimerobot

# AI Provider Timeout (Seconds)
AI_PROVIDER_TIMEOUT_SECONDS=25

# Hard Financial Guardrail Defaults (configurable per user in UI)
DEFAULT_MAX_DTI_RATIO=40.0
DEFAULT_MIN_RUNWAY_MONTHS=3.0
DEFAULT_CURRENCY=GHS

# AI Providers & Model IDs (All free-tier compatible across 4+ distinct model families)
# 1. Google Gemini Family
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# 2. Meta Llama Family via Groq
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# 3. Meta Llama Family via Cerebras (High-speed inference)
CEREBRAS_API_KEY=
CEREBRAS_MODEL_ID=llama3.3-70b

# 4. Mistral Family via Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL_ID=mistral-small-latest

# 5. DeepSeek / Qwen Family via OpenRouter Free Tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=deepseek/deepseek-chat

# 6. Local Offline Ollama (Enabled only when DEPLOYMENT_MODE=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=llama3.2
